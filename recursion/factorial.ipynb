   ],
   "source": [
    "def factorial (n):\n",
    "    if(n==1 or n==0):\n",
    "        return 1\n",
    "    return n * factorial (n-1)\n",
    "\n",
    "n=int(input(\"Enter a number:\"))\n",
    "print(f\"The factorial of this number is {factorial(n)}\")\n"
   ]
  }
